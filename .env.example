# Copy to .env, fill in, then run ./install.sh
# install.sh moves the API key into Keychain / secret-tool and blanks it here.
# Any value left empty here is read from your shell environment instead.

# Bedrock API key: Bedrock console > API keys > Generate long-term API key.
# Short-term keys expire after 12 hours.
AWS_BEARER_TOKEN_BEDROCK=

# Region you send requests to. Both models use cross-Region inference profiles.
AWS_REGION=us-east-1

# Comma-separated inference profile IDs. First = default model, second = /model opus.
# Kimi K3.1 Pro:  global.moonshotai.kimi-k3.1   (or us. / in. prefix)
# GLM 5.3:        global.zai.glm-5.3            (or us. prefix; eligible accounts only)
# Bare IDs (moonshotai.kimi-k3.1, zai.glm-5.3) do not work: in-Region inference is not supported.
BEDROCK_MODELS=global.moonshotai.kimi-k3.1,global.zai.glm-5.3

# Context size Claude Code assumes before compacting.
BEDROCK_CONTEXT_WINDOW=1000000

# Local LiteLLM proxy (translates Anthropic API <-> Bedrock OpenAI API). Listens on 127.0.0.1 only.
BEDROCK_PROXY_PORT=4000
# Package spec passed to `uv tool install`. Pin a version you trust, e.g. litellm[proxy]==1.83.0
LITELLM_SPEC=litellm[proxy]

# Switch the Claude Code chat panel in Cursor to Bedrock during install (on/off).
# Affects every Cursor window; `bedrock-cursor off` restores your normal setup.
BEDROCK_CURSOR=on
